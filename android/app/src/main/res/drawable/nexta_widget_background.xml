<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted-glass body: translucent white lets the launcher wallpaper
         show through while keeping widget content readable. -->
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="#A6FFFFFF"
                android:centerColor="#72FFFFFF"
                android:endColor="#52FFFFFF" />
        </shape>
    </item>

    <!-- Soft highlight along the upper edge. -->
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="90"
                android:startColor="#70FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Thin glass rim. -->
    <item>
        <shape>
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#B8FFFFFF" />
        </shape>
    </item>
</layer-list>
