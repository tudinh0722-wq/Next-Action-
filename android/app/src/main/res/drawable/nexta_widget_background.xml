<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="90"
                android:startColor="#66F9FE"
                android:endColor="#66F2FA" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="90"
                android:startColor="#38FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
