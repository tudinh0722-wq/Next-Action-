<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:startColor="@android:color/system_accent1_100"
                android:centerColor="@android:color/system_accent2_100"
                android:endColor="@android:color/system_accent3_100" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="90"
                android:startColor="#42FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
