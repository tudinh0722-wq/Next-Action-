<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidget provider metadata.
  minWidth / minHeight covers a 4x2 cell footprint on a standard launcher.
  updatePeriodMillis = 0  — updates are driven by AlarmManager inside
                            the app, not by the OS scheduler.
  resizeMode horizontal|vertical — user can resize after placement.
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_nexta"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
